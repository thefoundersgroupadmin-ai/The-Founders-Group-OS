# ~/.founderos/.env: how this Mac reaches Paperclip and the TFG OS backend.
# scripts/tfg-setup-machine.sh copies this file once and never overwrites it.
# Fill in the blanks (the comments say which can stay empty), then run the script again.

# Paperclip (the agent back-end). Ask the owner for the company id and a board key.
PAPERCLIP_URL=https://paperclip.thefoundersgroup.net
PAPERCLIP_API_URL=https://paperclip.thefoundersgroup.net
PAPERCLIP_COMPANY_ID=
PAPERCLIP_BOARD_KEY=
# Leave blank for the remote board (only for a keyless Paperclip on this same Mac).
PAPERCLIP_LOCAL_CHAT_WRITES=

# Device collector: where this Mac pushes its local sources, and the token for it.
FOUNDEROS_COLLECTOR_URL=
FOUNDEROS_COLLECTOR_TOKEN=

# Optional: your Obsidian vault, read-only.
OBSIDIAN_VAULT=
