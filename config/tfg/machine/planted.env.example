# ~/.founderos/planted.env: your own API keys and the inbox TFG OS sends from.
# scripts/tfg-setup-machine.sh copies this file once (mode 600) and never
# overwrites it. Use your own keys; nobody else needs to see them.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GITHUB_API_KEY=
SLACK_BOT_TOKEN=
RESEND_API_KEY=

# The inbox: IMAP to read replies, SMTP (Resend) to send approved email.
INBOX_1_NAME=
INBOX_1_HOST=
INBOX_1_USER=
INBOX_1_PASS=
INBOX_1_FROM=
INBOX_1_FROM_NAME=
INBOX_1_SMTP_HOST=smtp.resend.com
INBOX_1_SMTP_PORT=465
INBOX_1_SMTP_USER=resend
INBOX_1_SMTP_PASS=
